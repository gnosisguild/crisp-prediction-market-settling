# =============================================================================
# crisp-prediction-market — Sepolia config
# Copy to .env, fill in YOUR values. bun auto-loads it.
# =============================================================================

# --- Network ---
RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAIN_ID=11155111

# --- Existing real CRISP deployment on Sepolia (defaults to user's setup) ---
ENCLAVE=0xB47B267876B60a06138Bc9dfCee7aa3E26907CCB
CRISP_PROGRAM=0xA775f142d205ECd46a2B0F96569B1fa3acAC4476
FEE_TOKEN=0x9B1820D75bb09433D17C674A289fc6dD53e9c389
ENCLAVE_API=http://localhost:4000           # your running CRISP server

# --- Our Sepolia deployment (run `bun run sepolia` to populate) ---
USDC=
BONDS=
MANAGER=
ADAPTER=

# --- Active market (auto-written by the UI's create page; can also paste manually) ---
MARKET=

# --- Keys ---
# DEPLOYER_KEY: funds the adapter with fee USDC, settles, etc.
DEPLOYER_KEY=0x
# VOTER_KEY: the wallet that signs the CRISP ballot.
#   ⚠ MUST be one of the wallets in VOTERS below (so it holds CENSUS_TOKEN
#     and is in the CRISP server's census snapshot). The deployer is NOT
#     automatically an oracle.
#   ⚠ Each oracle also needs Sepolia ETH (publishInput costs ~0.001 ETH).
VOTER_KEY=0x

# --- Census ---
# CENSUS_TOKEN: ERC20 the CRISP server snapshots to determine WHO can vote.
# Each oracle wallet should hold ≥ 1 unit of this token. Default = DVT on Sepolia.
# The CRISP server's indexer handles the snapshot + setMerkleRoot — we don't.
CENSUS_TOKEN=0x0B27C944c2E0EEC1A7A0ABdf2F62b2ea9198Cf9b
# CREDIT_MODE controls HOW MUCH weight each voter gets:
#   0 = CONSTANT — every eligible voter gets CONSTANT_CREDITS credits (default)
#   1 = CUSTOM   — credits = token balance (weighted vote)
CREDIT_MODE=0
CONSTANT_CREDITS=1                          # one vote per oracle

# --- Committee voter roster ---
# Comma-separated list of voter wallets (will be funded with 1 CENSUS_TOKEN
# by `bun run fund-voters`). Each address needs Sepolia ETH for publishInput.
VOTERS=0x1E1722eF8751762ED05FF18a5A05A212A00A223f,0x0353d86A9517d6c378a2322536e762E9b0C039c9,0x4d088d9CF2B7f757eE4b10Ff45A31D35374794e7

# --- Voting choice defaults (override via CLI args) ---
SIDE=YES                                    # YES or NO
WEIGHT=1                                    # CONSTANT-mode: must be 1
